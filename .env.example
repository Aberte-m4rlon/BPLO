APP_NAME="Bansud BPLO Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# For local development, point to the Applicant app's SQLite database.
# For separate deployments, set all three apps to the same hosted MySQL database.
DB_DATABASE="../BUSINESS PERMIT_SYSTEM/app/database/database.sqlite"
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=bansud_bplo
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=bplo_system_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Local development: point to the Applicant app's private storage folder.
# For separate deployments, use the same mounted private-storage path or S3 bucket.
BPLO_PRIVATE_STORAGE="../BUSINESS PERMIT_SYSTEM/app/storage/app/private"
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=bplo_portal

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ============================================================
# Bansud Business Permit System â€” Custom Configuration
# ============================================================

# To use MySQL instead of SQLite, set:
#   DB_CONNECTION=mysql
#   DB_HOST=127.0.0.1
#   DB_PORT=3306
#   DB_DATABASE=bansud_permit
#   DB_USERNAME=root
#   DB_PASSWORD=

MUNICIPALITY_NAME="Municipality of Bansud"
MUNICIPALITY_PROVINCE="Oriental Mindoro"

SMS_DRIVER=log
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=BANSUD
SMS_BASE_URL=

PAYMENT_MODE=manual
PAYMENT_GCASH_ENABLED=true
PAYMENT_MAYA_ENABLED=true
PAYMENT_QRPH_ENABLED=true
# Receiving accounts shown on the Pay Fees page (manual mode)
PAYMENT_GCASH_NUMBER=
PAYMENT_GCASH_NAME=""
PAYMENT_MAYA_NUMBER=
PAYMENT_MAYA_NAME=
PAYMENT_QRPH_NUMBER=
PAYMENT_QRPH_NAME=
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
# Generate a random secret before enabling webhook verification.
PAYMENT_WEBHOOK_SECRET=

QR_HASH_SALT=change-this-to-a-long-random-string
PERMIT_VALID_MONTHS=12

# Address encoded in permit QR codes. Phones must be able to open it, so don't use
# localhost: use this PC's Wi-Fi IP for testing, or the real domain when deployed.
# Must be the public, phone-reachable verification URL of the Applicant app.
PERMIT_PUBLIC_URL=http://localhost:8000
